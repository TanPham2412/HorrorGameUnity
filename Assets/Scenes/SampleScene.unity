    disableFlashlightUntilViewed: 0
    unlockFlashlightAfterPlayback: 0
    monologueLines:
    - text: "...Th\xED nghi\u1EC7m? 'Ni\xEAm phong T\u1EA7ng 2'? B\u1ECDn h\u1ECD...
        b\u1ECDn h\u1ECD \u0111\xE3 l\xE0m g\xEC \u1EDF tr\xEAn \u0111\xF3?"
