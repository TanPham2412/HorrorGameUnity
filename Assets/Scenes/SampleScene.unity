  m_Script: {fileID: 11500000, guid: c235e9a38ff96f04d98ac76142957e2d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  TheDistance: 0
  ActionDisplay: {fileID: 1779885623}
  ActionText: {fileID: 298527861}
  NameObject: {fileID: 360506808}
  NoCassetteText: {fileID: 825322513}
  ExtraCross: {fileID: 1353870555}
  videoPlayer: {fileID: 1861909751}
  fullScreenVideoUI: {fileID: 1904268367}
  playerMovementScript: {fileID: 2096723365226007534}
  crosshair: {fileID: 1009350920}
  flashlightPickUp: {fileID: 423934309}
  tapeConfigs:
  - displayName: Guardroom Tape
    tapeItem: 2
    videoClip: {fileID: 32900000, guid: ae68c873ef2bfcb4486df8500ddd39e7, type: 3}
    disableFlashlightUntilViewed: 0
    unlockFlashlightAfterPlayback: 1
    monologueLines:
    - text: "...C\xE1i... c\xE1i qu\xE1i g\xEC v\u1EADy? G\xE3 b\u1EA3o v\u1EC7 \u0111\xF3...
        \xF4ng ta th\u1EA5y g\xEC v\u1EADy? Ti\u1EBFng c\u01B0\u1EDDi \u0111\xF3...
        l\xE0 c\xE1i g\xEC!!?"
      duration: 4
    - text: "M\xECnh ph\u1EA3i r\u1EDDi kh\u1ECFi \u0111\xE2y. Ngay l\u1EADp t\u1EE9c.
        Kh\xF4ng th\u1EC3 \u1EDF l\u1EA1i c\u0103n ph\xF2ng n\xE0y."
      duration: 4
    logMonologuesToLog: 1
    preventDuplicate: 1
    objectsToDeactivate: []
  - displayName: OfficeA Tape
    tapeItem: 3
    videoClip: {fileID: 32900000, guid: 2753e3d23fc1e394cb48e10c634b4ae6, type: 3}
    disableFlashlightUntilViewed: 0
    unlockFlashlightAfterPlayback: 0
    monologueLines:
    - text: "L\xC0 N\xD3! CH\xCDNH L\xC0 TH\u1EE8 TRONG NH\xC0 V\u1EC6 SINH! N\xF3...
        n\xF3 v\u1EEBa ph\xE1 n\xE1t l\u1ED1i l\xEAn T\u1EA7ng 2 r\u1ED3i! Ch\xFAa
        \u01A1i!"
      duration: 4
    - text: "...Kh\xF4ng, kh\xF4ng \u0111\u01B0\u1EE3c... Ph\u1EA3i b\xECnh t\u0129nh
        l\u1EA1i. H\xEDt s\xE2u v\xE0o... Nh\u1EDB l\u1EA1i \u0111i... Trong \u0111o\u1EA1n
        b\u0103ng, h\u1EAFn nh\u1EAFc \u0111\u1EBFn 'Th\xED nghi\u1EC7m'... 'Ni\xEAm
        phong T\u1EA7ng 2'"
      duration: 4
    - text: "B\u1ECDn h\u1ECD r\u1ED1t cu\u1ED9c \u0111\xE3 l\xE0m c\xE1i qu\xE1i
        g\xEC \u1EDF tr\xEAn \u0111\xF3? H\u1ED3 s\u01A1... b\xED m\u1EADt... t\u1EA5t
        c\u1EA3 \u0111\u1EC1u \u1EDF tr\xEAn kia. M\xECnh kh\xF4ng th\u1EC3 quay
        \u0111\u1EA7u n\u1EEFa. Ph\u1EA3i l\xEAn \u0111\xF3. Ph\u1EA3i bi\u1EBFt
        s\u1EF1 th\u1EADt."
      duration: 4
    logMonologuesToLog: 1
    preventDuplicate: 1
    objectsToDeactivate:
    - {fileID: 507455114}
    - {fileID: 373606523}
    - {fileID: 1475589589}
    - {fileID: 1876414772}
