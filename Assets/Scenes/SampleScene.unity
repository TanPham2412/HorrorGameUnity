  noteSprite: {fileID: 21300000, guid: 3fd91c83a736f044aaea865909551b08, type: 3}
  noteText: {fileID: 1646908431}
  noteContent: "Giao 1 b\xE1nh kem l\u1EDBn v\xE0o ng\xE0y 03/08. Ghi ch\xFA: Hi\u1EC7u
    tr\u01B0\u1EDFng."
  registerAsClue: 1
  clueLogEntry: 
  registerAsMonologue: 1
  monologueEntry: 
  playMonologueOnOpen: 0
  monologueVoiceLine: 
  monologueDuration: 4
  useSequenceMonologue: 1
  sequenceKey: Birthday0308
  firstSequenceLine: "H\u1EEBm, m\u1ED9t t\u1EDD gi\u1EA5y c\u0169 n\xE1t. 'Ng\xE0y
    03 th\xE1ng 08'... Ch\u1EAFc l\xE0 ng\xE0y k\u1EF7 ni\u1EC7m n\xE0o \u0111\xF3
    c\u1EE7a c\xE1i b\u1EC7nh vi\u1EC7n qu\xE1i qu\u1EF7 n\xE0y th\xF4i. Ch\u1EB3ng
    c\xF3 g\xEC quan tr\u1ECDng c\u1EA3."
  nextSequenceLine: "Khoan \u0111\xE3... L\u1EA1i l\xE0 '03 th\xE1ng 08'? T\u1EDD
    gi\u1EA5y l\xFAc n\xE3y c\u0169ng nh\u1EAFc \u0111\u1EBFn ng\xE0y n\xE0y. B\xE1nh
    kem... Sinh nh\u1EADt... ? 03... 08... Con s\u1ED1 n\xE0y c\xF3 l\u1EBD li\xEAn
    quan \u0111\u1EBFn m\u1ED9t th\u1EE9 g\xEC \u0111\xF3?"
  sequenceMonologueDuration: 6
  sequenceLineAddsToLog: 1
  playerMovementScript: {fileID: 2096723365226007534}
  crosshair: {fileID: 1009350920}
