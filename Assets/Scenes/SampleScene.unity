--- !u!114 &17388782
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 17388780}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3546681e5e3509b4ebb64657e49810c0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  TheDistance: 0
  ActionDisplay: {fileID: 1779885623}
  ActionText: {fileID: 1251258818}
  NameObject: {fileID: 875106035}
  ExtraCross: {fileID: 1353870555}
  interactionRange: 3
  notePanel: {fileID: 411297867}
  noteImage: {fileID: 411297869}
  noteSprite: {fileID: 21300000, guid: 3fd91c83a736f044aaea865909551b08, type: 3}
  noteText: {fileID: 1926687811}
  noteContent: "Th\xED nghi\u1EC7m th\xE0nh c\xF4ng. Ta \u0111\xE3 d\xF9ng 5 K\u1EF7
    V\u1EADt g\u1EAFn li\u1EC1n v\u1EDBi n\u1ED7i \u0111au c\u1EE7a n\xF3, x\u1EBFp
    theo chi\u1EC1u KIM \u0110\u1ED2NG H\u1ED2 \u0111\u1EC3 tr\xF3i bu\u1ED9c linh
    h\u1ED3n n\xF3 v\u0129nh vi\u1EC5n, bi\u1EBFn n\xF3 th\xE0nh k\u1EBB g\xE1c c\u1ED5ng
    \u0111i\xEAn lo\u1EA1n.\r\nMu\u1ED1n ph\xE1 gi\u1EA3i, ph\u1EA3i t\xECm \u0111\u1EE7
    5 th\u1EE9 \u0111\xF3 v\xE0 x\u1EBFp NG\u01AF\u1EE2C CHI\u1EC0U KIM \u0110\u1ED2NG
    H\u1ED2 t\u1EA1i PH\xD2NG M\xC1Y. V\u1ECB tr\xED b\u1EAFt \u0111\u1EA7u l\xE0
    v\u1ECB tr\xED h\u01B0\u1EDBng v\u1EC1 ph\xEDa C\u1EECA.\nTa \u0111\xE3 gi\u1EA5u
    ch\xFAng t\u1EA1i n\u01A1i c\u01A1n \xE1c m\u1ED9ng b\u1EAFt \u0111\u1EA7u:\r\n-N\u01A1i
    l\u0169 tr\u1EBB h\u1ECDc c\xE1ch im l\u1EB7ng, v\xE0 con b\xFAp b\xEA ch\xE1y
    x\xE9m l\xE0 nh\xE2n ch\u1EE9ng duy nh\u1EA5t.\n-C\u0103n ph\xF2ng n\u1ED3ng
    n\u1EB7c m\xF9i c\u1ED3n, n\u01A1i l\u01B0\u1EE1i dao r\u1EC9 s\xE9t \u0111\xE3
    c\u1EAFt b\u1ECF nh\xE2n t\xEDnh c\u1EE7a n\xF3. \n-G\xF3c b\u1EBFp l\u1EA1nh
    l\u1EBDo, n\u01A1i b\u1EEFa \u0103n cu\u1ED1i c\xF9ng l\xE0 b\xE1t thu\u1ED1c
    \u0111\u1ED9c.\n-Chi\u1EBFc l\u1ED3ng v\xE0ng \xEAm \xE1i, n\u01A1i ti\u1EBFng
    nh\u1EA1c vang l\xEAn nh\u01B0ng kh\xF4ng ai \u0111\u01B0\u1EE3c ng\u1EE7.\n-V\xE0
    n\u01A1i cu\u1ED1i c\xF9ng... ph\xF2ng ki\u1EC3m tra, n\u01A1i t\u1EF1 do b\u1ECB
    t\u01B0\u1EDBc \u0111o\u1EA1t b\u1EDFi nh\u1EEFng s\u1EE3i x\xEDch."
  registerAsClue: 1
  clueLogEntry: 
  registerAsMonologue: 1
  monologueEntry: "V\u1EADy ra... con ma \u0111\xF3 kh\xF4ng t\u1EF1 nhi\xEAn m\xE0
    \u0111i\xEAn lo\u1EA1n. Ch\xEDnh h\u1EAFn \u0111\xE3 bi\u1EBFn c\xF4 \u1EA5y
    th\xE0nh qu\xE1i v\u1EADt \u0111\u1EC3 canh gi\u1EEF n\u01A1i n\xE0y. 'Ng\u01B0\u1EE3c
    chi\u1EC1u kim \u0111\u1ED3ng h\u1ED3' t\u1EA1i Ph\xF2ng M\xE1y... \u0110\xF3
    l\xE0 ch\xECa kh\xF3a! Ph\u1EA3i t\xECm \u0111\u1EE7 5 k\u1EF7 v\u1EADt n\xE0y
    \u1EDF c\xE1c ph\xF2ng h\u1EAFn nh\u1EAFc t\u1EDBi. Ph\u1EA3i nhanh l\xEAn, tr\u01B0\u1EDBc
    khi 'k\u1EBB g\xE1c c\u1ED5ng' \u0111\xF3 t\xECm th\u1EA5y."
  playMonologueOnOpen: 1
  monologueVoiceLine: 
  monologueDuration: 6
  useSequenceMonologue: 0
  sequenceKey: 
  firstSequenceLine: 
  nextSequenceLine: 
  sequenceMonologueDuration: 4
  sequenceLineAddsToLog: 0
  playerMovementScript: {fileID: 2096723365226007534}
  crosshair: {fileID: 1009350920}
